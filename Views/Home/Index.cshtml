@{
    ViewData["Title"] = "Home Page";
}

<section>
    <div>
        <form action='@Url.Action("Datos", "Home")' method="post" enctype="multipart/form-data">
            Nombre Completo: <input type="text" name="nombre">
            Edad: <input type="number" name="edad">
            DNI: <input type="number" name="dni">
            ¿Actualmente trabaja?: 
            <input type="radio" name="trabajo" value="Si">Si
            <input type="radio" name="trabajo" value="No">No
            Tipo de empleo: 
            <select name="tipoTrabajo">
                <option value="1">Relación de dependencia</option>
                <option value="2">Monotributista</option>
                <option value="3">Autonomo</option>
                <option value="4">Desempleado</option>
            </select>

            Ingreso mensual: <input type="number" name="ingreso">
            ¿Posee otras deudas?: 
            <input type="radio" name="deudas" value="Si">Si
            <input type="radio" name="deudas" value="No">No

           monto solicitado: <input type="number" name= "monto">
           plazo:  <select name="plazo">
           <option value ="1">6 meses </option>
           <option value ="2"> 12 meses </option>
           <option value ="3">24 meses </option>
           

        ¿Acepta los términos y concidiciones?:
        <input type= "checkbox" name = "terminos" value="Si"> Si
        <input type= "checkbox" name = "terminos" value="No"> No
        </form>
    </div>

</section>

